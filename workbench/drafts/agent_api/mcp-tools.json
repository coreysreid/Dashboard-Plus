{
  "status": "design only; API skeleton awaits approval",
  "transport": "MCP stdio",
  "api_base": "http://127.0.0.1:<current-port>/api/v1",
  "tools": [
    {
      "name": "dashboard_me",
      "description": "Show this helper’s current access and limits. Never returns the key.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "path": "/me"
      },
      "mode": "read"
    },
    {
      "name": "dashboard_tables",
      "description": "List only the modules, tables and nonprivate fields this helper may read or suggest.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "path": "/tables"
      },
      "mode": "read"
    },
    {
      "name": "dashboard_list_records",
      "description": "Read a page of current nonprivate records from one granted table. Linked IDs must obey the helper’s grants.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string"
          },
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "table"
        ],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "path": "/tables/{table}/records"
      },
      "mode": "read"
    },
    {
      "name": "dashboard_get_record",
      "description": "Read one current nonprivate record from a granted table by its ID.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string"
          },
          "record_id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "table",
          "record_id"
        ],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "path": "/tables/{table}/records/{record_id}"
      },
      "mode": "read"
    },
    {
      "name": "dashboard_attention",
      "description": "Read Needs attention only for the helper’s granted modules. These are household records, not a safety judgement.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "path": "/attention"
      },
      "mode": "read"
    },
    {
      "name": "dashboard_suggest_new_records",
      "description": "Suggest new records for a person to inspect on Review. This changes no live record now. Reuse the same request_key on retry.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9._:-]+$"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "properties": {
                "table": {
                  "type": "string"
                },
                "values": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "required": [
                "table",
                "values"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "request_key",
          "why",
          "entries"
        ],
        "additionalProperties": false
      },
      "api": {
        "method": "POST",
        "path": "/proposals"
      },
      "mode": "suggest"
    },
    {
      "name": "dashboard_list_suggestion_batches",
      "description": "List this helper’s own suggestion batches and their review counts.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "after": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "path": "/batches"
      },
      "mode": "read"
    },
    {
      "name": "dashboard_get_suggestion_batch",
      "description": "Read this helper’s own batch status after a person reviews it. This cannot accept or reject.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "batch_id": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "batch_id"
        ],
        "additionalProperties": false
      },
      "api": {
        "method": "GET",
        "path": "/batches/{batch_id}"
      },
      "mode": "read"
    }
  ]
}
